# MeshCore MQTT Broker Configuration
# Copy this file to .env and fill in your values

# Docker Container Permissions (used by docker-entrypoint.sh when running in Docker)
# PUID=1000
# PGID=1000

# Logging Level (info or debug; default: info)
LOG_LEVEL=info

# MQTT Server Settings
MQTT_WS_PORT=8883
MQTT_HOST=0.0.0.0

# Optional Standard TCP MQTT listener (for Mosquitto bridges)
# WARNING: TCP port 1883 is plain unencrypted MQTT (subscriber passwords cross the network in cleartext).
# Keep port 1883 restricted to localhost, a private Docker network/VPN, or behind a TLS terminator.
ENABLE_TCP_MQTT=false
MQTT_TCP_PORT=1883

# Authentication Settings
# Expected audience claim in JWT tokens (e.g., mqtt.yourdomain.com)
# Leave empty to skip audience validation
AUTH_EXPECTED_AUDIENCE=mqtt.yourdomain.com

# HTTP Web Browser Redirect (Optional)
# If set, non-WebSocket HTTP requests to / will redirect (HTTP 302) to this URL.
# /health and /healthz always return HTTP 200 OK {"status":"ok","service":"MeshCore MQTT Broker"} for healthchecks.
# If left empty, / also returns the HTTP 200 OK JSON status response.
HTTP_REDIRECT_URL=

# Packet & Network Protection Settings
# Maximum allowed packet payload size in bytes (default: 65536 = 64KB)
MQTT_MAX_PACKET_BYTES=65536

# $SYS Telemetry Interval (Optional)
# Interval in milliseconds between retained $SYS/broker/# telemetry updates for Role 1 (Admin) subscribers (default: 10000 = 10s)
MQTT_SYS_INTERVAL_MS=10000

# Subscribe-Only & Peer Users (one per line, format: username:password:role:maxConnections)
# Role: 1=admin (full access + can delete retained + remote serial commands), 2=full_access (no hidden data), 3=limited (filtered data), 4=peer (inbound peer broker)
# Default role is 3 (limited) if not specified
# maxConnections: number for override, D or omit to use default (SUBSCRIBER_MAX_CONNECTIONS_DEFAULT)
# IMPORTANT: Number sequentially starting at SUBSCRIBER_1 without gaps (loader stops at the first missing number)
SUBSCRIBER_MAX_CONNECTIONS_DEFAULT=2
SUBSCRIBER_1=viewer1:your-secure-password-here:2
SUBSCRIBER_2=admin:admin-password-here:1:10
SUBSCRIBER_3=limited:limited-password:3:D
# ... add more as needed


# Peer Broker Interconnect (Optional - Origin-Only Forwarding)
# A broker ONLY forwards packets received from local observers (ClientType.PUBLISHER),
# and NEVER re-forwards packets received from another peer broker.
#
# PEER_PRIVATE_KEY: Optional 64-char (seed) or 128-char (full) Ed25519 hex private key.
# If omitted when peers are configured, a keypair is auto-generated and saved to /data/peer-identity.json.
# PEER_PRIVATE_KEY=
#
# AUTHORIZED_PEERS: Comma-separated 64-char Ed25519 hex public keys of remote peer brokers allowed to push into this broker.
# AUTHORIZED_PEERS=
#
# Outbound Peer Queue Bounds (used when an outbound peer link is temporarily disconnected)
PEER_QUEUE_MAX_SIZE=5000
PEER_QUEUE_MAX_BYTES=8388608
PEER_QUEUE_TTL_MS=600000
# Inbound/Outbound Peer Rate Limit (messages per second per peer; receiver burst = max(PEER_QUEUE_MAX_SIZE, 2x); keep matched across peered brokers)
PEER_RATE_LIMIT_PER_SEC=500
#
# Outbound Peers (sequential PEER_1, PEER_2, ... without gaps):
# Format 1 (Ed25519 JWT Auth - recommended): wss://peer.example.com:8883|peer.example.com
# Format 2 (Role-4 Username/Password Auth):  wss://peer.example.com:8883|peer_user|peer_pass
# PEER_1=wss://broker-b.yourdomain.com|broker-b.yourdomain.com
# PEER_2=wss://broker-c.yourdomain.com|broker-c.yourdomain.com


# Abuse Detection - Enforcement & Temporary Timeout
# When true, clients exceeding thresholds are muted and their packets are silently dropped for ABUSE_MUTE_DURATION_MS
ABUSE_ENFORCEMENT_ENABLED=false
# Duration in milliseconds that muted violators are put in timeout (default: 4 hours = 14400000 ms)
ABUSE_MUTE_DURATION_MS=14400000

# Abuse Detection - Duplicate Detection
ABUSE_DUPLICATE_WINDOW_SIZE=100
ABUSE_DUPLICATE_WINDOW_MS=300000
ABUSE_DUPLICATE_THRESHOLD=10
ABUSE_MAX_DUPLICATES_PER_PACKET=5
ABUSE_DUPLICATE_RATE_THRESHOLD=0.3
ABUSE_DUPLICATE_RATE_WINDOW_MS=300000

# Abuse Detection - Rate Limiting (Token Bucket)
ABUSE_BUCKET_CAPACITY=20
ABUSE_BUCKET_REFILL_RATE=3

# Abuse Detection - Anomaly Detection
# ABUSE_MAX_PACKET_SIZE checks the byte length of the hex-encoded 'raw' LoRa packet field (default: 255 bytes)
ABUSE_MAX_PACKET_SIZE=255
ABUSE_MAX_TOPICS_PER_DAY=3
ABUSE_ANOMALY_THRESHOLD=10

# Abuse Detection - IATA Change Limiting
ABUSE_MAX_IATA_CHANGES_24H=3

# Abuse Detection - Topic Tracking
ABUSE_TOPIC_HISTORY_SIZE=50
ABUSE_TOPIC_HISTORY_WINDOW_MS=86400000

# Abuse Detection - Persistence (SQLite)
ABUSE_PERSISTENCE_PATH=/data/abuse-detection.db
ABUSE_PERSISTENCE_INTERVAL_MS=300000
# Evict trust state for clients with no activity within this window (default 7 days = 604800000 ms).
# Keeps the persisted store bounded by active clients rather than every client ever seen.
ABUSE_STATE_RETENTION_MS=604800000
