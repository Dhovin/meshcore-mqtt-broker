# MeshCore MQTT Broker Configuration
# Copy this file to .env and fill in your values

# MQTT Server Settings
MQTT_WS_PORT=8883
MQTT_HOST=0.0.0.0

# Authentication Settings
# Expected audience claim in JWT tokens (e.g., mqtt.yourdomain.com)
# Leave empty to skip audience validation
AUTH_EXPECTED_AUDIENCE=mqtt.yourdomain.com

# Subscriber Users (one per line, format: username:password:role:maxConnections)
# Role:
#   1 = admin (full access + can delete retained + serial commands)
#   2 = full_access (no hidden data)
#   3 = limited (filtered data: SNR, RSSI, score, stats removed)
#   4 = peer (broker-to-broker bridge; can publish forwarded meshcore packets across origin IDs)
# Default role is 3 (limited) if not specified
# maxConnections: number for override, D or omit to use default (SUBSCRIBER_MAX_CONNECTIONS_DEFAULT)
# Add as many as you need by incrementing the number
SUBSCRIBER_MAX_CONNECTIONS_DEFAULT=2
SUBSCRIBER_1=viewer1:your-secure-password-here:2
SUBSCRIBER_2=admin:admin-password-here:1:10
SUBSCRIBER_3=limited:limited-password:3:D
SUBSCRIBER_4=peer_guy_b:secure-peer-password-here:4
# ... add more as needed

# Peer Interconnect & Packet Forwarding
# Single multiplexed WebSocket interconnect with native MeshCore Ed25519 JWT authentication.
#
# 1. Broker Peer Identity:
# Optional: 32-byte seed (64 hex chars) or 64-byte private key (128 hex chars) for this broker.
# If omitted, a persistent keypair is automatically generated and saved to data/peer-identity.json.
# PEER_PRIVATE_KEY=your-64-or-128-hex-char-private-key
#
# 2. Inbound Peer Authorization:
# Comma-separated 64-hex public keys of remote peer brokers authorized to connect and push packets.
# Alternatively, use PEER_1_KEY=..., PEER_2_KEY=...
# AUTHORIZED_PEERS=4852B69364572B52EFA1B6BB3E6D0ABED4F389A1CBFBB60A9BBA2CCE649CAF0E
#
# 3. Outbound Peer Targets:
# Configure outbound peer broker targets to push local traffic to remote brokers.
# Standard JWT Interconnect Format: PEER_N=URL:target_audience
# (Also supports legacy credentials format: PEER_N=URL:username:password)
# PEER_1=wss://guy-a.example.com:443:guy_a_broker_audience
# PEER_2=ws://guy-b.local:8883:guy_b_audience
#
# Max queued packets per peer during disconnections before dropping oldest (default: 1000)
PEER_QUEUE_MAX_SIZE=1000

# Abuse Detection - Enforcement
ABUSE_ENFORCEMENT_ENABLED=false

# Abuse Detection - Duplicate Detection
ABUSE_DUPLICATE_WINDOW_SIZE=100
ABUSE_DUPLICATE_WINDOW_MS=300000
ABUSE_DUPLICATE_THRESHOLD=10
ABUSE_MAX_DUPLICATES_PER_PACKET=5
ABUSE_DUPLICATE_RATE_THRESHOLD=0.3
ABUSE_DUPLICATE_RATE_WINDOW_MS=300000

# Abuse Detection - Rate Limiting
ABUSE_BUCKET_CAPACITY=20
ABUSE_BUCKET_REFILL_RATE=3

# Abuse Detection - Anomaly Detection
ABUSE_MAX_PACKET_SIZE=255
ABUSE_MAX_TOPICS_PER_DAY=3
ABUSE_ANOMALY_THRESHOLD=10

# Abuse Detection - IATA Change Limiting
ABUSE_MAX_IATA_CHANGES_24H=3

# Abuse Detection - Topic Tracking
ABUSE_TOPIC_HISTORY_SIZE=50
ABUSE_TOPIC_HISTORY_WINDOW_MS=86400000

# Abuse Detection - Persistence
ABUSE_PERSISTENCE_PATH=/data/abuse-detection.db
ABUSE_PERSISTENCE_INTERVAL_MS=300000
# Evict trust state for clients with no activity within this window (default 7 days).
# Keeps the persisted store bounded by active clients rather than every client ever seen.
ABUSE_STATE_RETENTION_MS=604800000
